POSTGRES_PASSWORD=replace-with-local-random-secret
DATABASE_URL=postgresql://msn_owner:replace-with-local-random-secret@127.0.0.1:55438/msn_cricket
RUNTIME_DATABASE_URL=postgresql://msn_runtime:replace-with-runtime-secret@127.0.0.1:55438/msn_cricket
RUNTIME_PASSWORD=replace-with-runtime-secret
API_PORT=4018
WEB_ORIGIN=http://localhost:3018
API_URL=http://127.0.0.1:4018
# Production: configure issuer/audience/JWKS for verified-email identity tokens.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Local fictional rehearsal only. Refused when NODE_ENV=production.
ENABLE_REHEARSAL_LOGIN=true

WORKER_PASSWORD=replace-with-worker-secret
WORKER_DATABASE_URL=postgresql://msn_worker:replace-with-worker-secret@127.0.0.1:55438/msn_cricket
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:59018
S3_BUCKET=msn-cricket-local
S3_ACCESS_KEY=msn-local
S3_SECRET_KEY=replace-with-storage-secret
# Optional payment adapter; merchant/provider still requires owner confirmation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_ID=
RAZORPAY_WEBHOOK_SECRET=

AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Provider-specific allowed MFA acr claims, comma-separated. Standard amr=mfa is recognized.
OIDC_MFA_ACR_VALUES=
# Set maintenance periods only after the club/platform retention policy is agreed.
ORPHAN_IMAGE_DAYS=
SESSION_RETENTION_DAYS=
MAINTENANCE_INTERVAL_SECONDS=300
# Authorized platform identity used by the trusted reconciliation worker.
RECONCILIATION_ACTOR_ID=
