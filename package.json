{
  "name": "msn-cricket-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/domain/test/*.test.mjs",
    "test:prototype": "node --test prototype/*.test.js",
    "dev:api": "node --env-file=.env --import tsx apps/api/src/main.ts",
    "dev:web": "npm run dev --workspace=@msn/web",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "test:integration": "node --env-file=.env --import tsx --test apps/api/test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "npm run build:api && npm run build --workspace=@msn/web",
    "test:e2e": "npm run db:seed && playwright test",
    "lint": "eslint apps packages scripts tests playwright.config.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,mjs}\" \"scripts/*.{ts,mjs}\" \"tests/*.ts\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,mjs}\" \"scripts/*.{ts,mjs}\" \"tests/*.ts\" \"*.{ts,mjs,json}\"",
    "build:api": "tsc -p tsconfig.api.json",
    "test:restore": "node --env-file=.env --import tsx scripts/restore-check.ts",
    "storage:config": "node --env-file=.env scripts/storage-config.mjs",
    "storage:init": "node --env-file=.env --import tsx scripts/storage-init.ts",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "worker:once": "node --env-file=.env --import tsx scripts/worker.ts --once",
    "test:load": "node --env-file=.env --import tsx scripts/load-auction.ts",
    "test:fresh": "node --env-file=.env --import tsx scripts/check-fresh-database.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/platform-socket.io": "12.5.0",
    "@nestjs/websockets": "12.5.0",
    "jose": "6.2.17",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
